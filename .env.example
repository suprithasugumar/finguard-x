# SEC EDGAR API compliance (R4: Declare User-Agent with app name + contact email)
# Validated lazily when SEC client is invoked.
SEC_USER_AGENT=FinGuardX-Research/1.0 (researcher@example.com)

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://druid:FoolishPassword@localhost:5432/finguard
TEST_DATABASE_URL=postgresql://druid:FoolishPassword@localhost:5432/finguard_test

# Reproducibility (R6)
SEED=42

# Environment & Logging
APP_ENV=development
LOG_LEVEL=INFO
